# =============================================================================
# videoagent — example environment
#
# Copy to `.env` and fill in what you need:
#     cp .env.example .env          # (PowerShell: copy .env.example .env)
#
# `.env` is gitignored. Never commit real keys.
#
# Every variable below is read by `Settings` in src/videoagent/config.py, which is
# the single place that maps env -> behaviour. Names are case-insensitive and
# unknown variables are ignored. Values shown as `# VAR=x` are the built-in
# defaults — uncomment only to change them.
#
# Nothing here is required to import the package or run the test suite: a
# completely empty `.env` is valid. Missing credentials fail at the moment a
# provider actually needs them, with an error naming the variable.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — OpenRouter, two capability tiers behind one interface
# -----------------------------------------------------------------------------

# OpenRouter API key. Required before any real LLM call.
# Get one at https://openrouter.ai/keys
# Note: reaching some `:free` models also requires enabling the prompt-logging
# data policy toggle in your OpenRouter account settings.
OPENROUTER_API_KEY=

# OpenAI-compatible endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The two model IDs. THESE HAVE NO DEFAULTS, DELIBERATELY.
# OpenRouter retires `:free` models and moves them to paid without notice, so a
# hardcoded ID is a time-bomb that keeps "working" against a dead model. Pick
# current IDs from https://openrouter.ai/models?max_price=0 and set them here.
#
#   draft  — small/fast; the high-volume scriptwriter + ideation calls
#   judge  — distinctly STRONGER than the drafter; the eval critic, once per video
#
# The judge must outclass the drafter or the eval loop is meaningless (CLAUDE.md
# section 5). The judge runs once per video, so pointing it at a cheap *paid* ID is
# the low-cost way to keep evals reliable if free judge models get throttled.
LLM_DRAFT_MODEL=
LLM_JUDGE_MODEL=

# Global tier override: auto | draft | judge.
# `auto` (default) keeps every node on its natural tier and is the only mode in
# which eval scores are trustworthy. `draft` forces ALL calls (including the
# judge) onto the draft model — useful when the daily quota is nearly spent or for
# cheap smoke runs. `judge` forces all calls onto the judge model.
# LLM_TIER=auto

# Free-tier limits are load-bearing: 20 requests/minute always, and 50/day until a
# one-time $10 credit purchase raises it to 1,000/day permanently. A failed call
# still burns daily quota, so retries are exponentially backed off, never blind.
# LLM_REQUEST_TIMEOUT_SECONDS=60.0
# LLM_MAX_RETRIES=4
# LLM_BACKOFF_BASE_SECONDS=2.0


# -----------------------------------------------------------------------------
# Provider selection
# -----------------------------------------------------------------------------

# Text-to-speech: piper (local, zero cost) | elevenlabs (paid, better)
# TTS_PROVIDER=piper

# Visual assets: stock (Pexels/Pixabay + ffmpeg) | generative (opt-in, costs money)
# VIDEO_PROVIDER=stock

# Publishing: file | youtube | aggregator
# MUST stay `file` unless you intend to post for real. `file` writes the video and
# a metadata JSON to OUTPUT_DIR and posts nothing (CLAUDE.md 4b). Real posting is
# strictly opt-in, and the human-approval gate still applies either way.
# PUBLISH_PROVIDER=file


# -----------------------------------------------------------------------------
# TTS credentials  (only needed for the provider you selected)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Path to (or name of) the local Piper voice model, e.g. en_US-amy-medium.onnx
PIPER_VOICE_MODEL=


# -----------------------------------------------------------------------------
# Video-asset credentials
# -----------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Only for VIDEO_PROVIDER=generative.
GENERATIVE_VIDEO_API_KEY=


# -----------------------------------------------------------------------------
# Publishing credentials  (only for real posting; not needed with PUBLISH_PROVIDER=file)
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

AGGREGATOR_API_KEY=
AGGREGATOR_BASE_URL=


# -----------------------------------------------------------------------------
# Checkpointer — swapping backends is a config change, never a code change
# -----------------------------------------------------------------------------

# sqlite (local dev) | postgres (deployment)
# CHECKPOINTER=sqlite

# SQLite file, used when CHECKPOINTER=sqlite. Parent dir is created on demand.
# SQLITE_CHECKPOINT_PATH=data/checkpoints.sqlite

# Postgres DSN, required when CHECKPOINTER=postgres.
POSTGRES_URL=


# -----------------------------------------------------------------------------
# Graph tuning
# -----------------------------------------------------------------------------

# Minimum rubric score (0-10) a script must reach. Below it, the conditional edge
# loops back to the scriptwriter.
# EVAL_SCORE_THRESHOLD=7.0

# How many times the scriptwriter may be retried after a failed eval. Bounded on
# purpose — an unbounded retry loop burns the daily quota.
# MAX_SCRIPT_RETRIES=2


# -----------------------------------------------------------------------------
# Output and observability
# -----------------------------------------------------------------------------

# Where FileProvider writes rendered videos + metadata.
# OUTPUT_DIR=out

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# LangSmith tracing is optional and off by default; structured logging is always on.
# LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
